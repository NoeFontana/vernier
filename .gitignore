*.py[cod]
*$py.class
*.so
*.pyd
.Python
.pytest_cache/
.ruff_cache/
.pyright/
.mypy_cache/
*.egg-info/
build/
dist/

# uv / venv
.venv/
.env
.python-version.local

# Maturin
/python/vernier/_core*.so
/python/vernier/_core*.pyd

